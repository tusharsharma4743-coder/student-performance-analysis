# 25 Which variable among study hours, attendance, and sleep has the strongest effect in the regression model

model3 <- lm(overall_score ~ study_hours_per_day +
               attendance_percentage +
               sleep_hours,
             data = student_performance)

summary(model3)

# 26 What is the relationship between study hours per day and overall student performance

ggplot(student_performance,
       aes(x = study_hours_per_day, y = overall_score)) +
  geom_point(color = "blue") +
  geom_smooth(method = "lm", se = FALSE, color = "red") +
  labs(title = "Linear Regression: Study Hours vs Score",
       x = "Study Hours",
       y = "Overall Score")

# The scatter plot with a regression line shows a positive relationship between study hours and overall score
# As study hours increase, the overall score also tends to increase. This suggests that students who study more generally achieve better academic performance
