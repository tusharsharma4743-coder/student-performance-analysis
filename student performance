low_student  
head(low_student,10)

 
# 4 Overall scores
ggplot(student_performance, aes(x = overall_score)) +
  geom_histogram(binwidth = 5, fill = "red", color = "black") +
  labs(title = "Distribution of Scores", x = "Score", y = "Count")

# This show how student scores are spread across different ranges most student are concentrated in the middle range, indicating average performance
# while fewer student appear at the extreme high and low score this helps identify whether the overall performance is balanced or skewed


# 5. Score categories

student_performance$score_groups <- ifelse(student_performance$overall_score >= 75, "High",
                                           ifelse(student_performance$overall_score >= 50, "Medium", "Low"))

ggplot(student_performance, aes(x = score_groups, fill = score_groups)) +
  geom_bar() +
  labs(title = "Score Categorise", x = "Categories", y = "Count")

# The Bar graph display the number of student in each performance category it clearly shows which group has the highest count 
# this help in understanding whether most student are performing well, moderately, or poorly

# 6. Student study hours vs score
ggplot(student_performance, aes(x = study_hours_per_day, y = overall_score)) +
  geom_point(color = "blue") +
  labs(title = "Study Hours vs Score", x = "Study Hours", y = "Score")


