# Call the library
library(dplyr)
library(ggplot2)
library(GGally)


student_performance <- read.csv("C:/Term 4/CAP 482 DATA EXPLORATION AND PREPRATION/Jan2026/Project/student_performance_data.csv")

# View Data set
View(student_performance)

# 1. What is the structure of the data set (number of rows, columns, and data types)?

# Structure of Data Set
str(student_performance)

# Print column names
names(student_performance)

# First 6 rows
head(student_performance)

# Last 6 rows
tail(student_performance)

# Summary of data
summary(student_performance)

# Check dimensions
dim(student_performance)

# Convert gender to factor
student_performance$gender <- as.factor(student_performance$gender)

# 2. Find Missing values and handle

# Check missing values
colSums(is.na(student_performance))

# 2.1. Filtering Data

high_score <- student_performance %>%
  filter(student_performance$overall_score > 80) %>% 
  select(student_id, overall_score)

high_score

head(high_score)

# 2.2 Top 10 students

top_student <- student_performance %>% 
  arrange(desc(overall_score)) %>% 
  select(student_id, overall_score) %>% 
  head(10)

top_student

# 2.3 Rank All the student

rank_student <- student_performance %>% 
  arrange(desc(overall_score)) %>% 
  mutate(rank = row_number())

rank_student  
head(rank_student)

# 2.4 Find the topper

topper <- rank_student %>% 
  filter(rank == 1) %>% 
  select(student_id,overall_score,rank)
topper

# This Show the best performing student


# 2.5 Show Top 10 best Performing Student

top10_student <- rank_student %>% 
  select(student_id,overall_score,rank) %>% 
  head(10)

top10_student

# 2.6 Average of top10 student marks

avg_score_top10 <- top10_student %>% 
  summarise(mean(overall_score))
avg_score_top10

# The average score of the top 10 students was calculated to understand the performance level of the high achievers the result
# Shows that top performing students have significantly higher scores compared to the overall dataset average

